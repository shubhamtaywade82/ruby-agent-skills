#!/usr/bin/env bash
# Validate every skill with the official Agent Skills reference validator
# (skills-ref, https://agentskills.io/specification), pinned to a commit so
# local and CI runs check against the same rules.
#
# Exit codes: 0 all skills pass, 1 at least one skill fails,
#             3 skills-ref is unavailable (never reported as a pass).
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
SKILLS_REF_COMMIT="69ef37e9424c0a7ea9dd2293b559e43ec8176379"
SKILLS_REF_SOURCE="git+https://github.com/agentskills/agentskills@${SKILLS_REF_COMMIT}#subdirectory=skills-ref"

if command -v skills-ref >/dev/null 2>&1; then
  runner=(skills-ref)
elif command -v uvx >/dev/null 2>&1; then
  runner=(uvx --from "$SKILLS_REF_SOURCE" skills-ref)
else
  echo "skills-ref unavailable: install it (pip install \"$SKILLS_REF_SOURCE\") or install uv" >&2
  exit 3
fi

passed=0
failed=0
for skill_dir in "$ROOT"/skills/*/; do
  if output="$("${runner[@]}" validate "$skill_dir" 2>&1)"; then
    passed=$((passed + 1))
  else
    failed=$((failed + 1))
    echo "FAIL ${skill_dir#"$ROOT"/}: $output" >&2
  fi
done

echo "Agent Skills specification (skills-ref ${SKILLS_REF_COMMIT:0:7}): ${passed} passed, ${failed} failed"
[[ "$failed" -eq 0 ]]
