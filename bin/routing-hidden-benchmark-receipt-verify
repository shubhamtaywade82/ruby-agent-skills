#!/usr/bin/env ruby
# frozen_string_literal: true

require "digest"
require "json"
require "optparse"

options = {check_files: false}
OptionParser.new do |opts|
  opts.banner = "usage: ruby bin/routing-hidden-benchmark-receipt-verify RECEIPT_JSON [options]"
  opts.on("--check-files", "Verify the recorded external artifact SHA-256 and byte size") { options[:check_files] = true }
end.parse!

path = File.expand_path(ARGV.fetch(0) { abort "hidden benchmark receipt JSON is required" })
abort "hidden benchmark receipt not found: #{path}" unless File.file?(path)

receipt = JSON.parse(File.read(path, encoding: "UTF-8"))
errors = []

errors << "protocol_version must be 1" unless receipt["protocol_version"].to_i == 1
errors << "receipt type must be skill-routing-hidden-benchmark-intake-v1" unless receipt["receipt"] == "skill-routing-hidden-benchmark-intake-v1"

verification = receipt["verification"]
errors << "verification must be a mapping" unless verification.is_a?(Hash)
if verification.is_a?(Hash)
  errors << "verification.passed must be true" unless verification["passed"] == true
  errors << "source must be external-only" unless verification["source"] == "external-only"
  errors << "repository storage must remain forbidden" unless verification["repository_storage"] == "forbidden"
  errors << "gold labels must not enter the repository" unless verification["gold_labels_in_repository"] == false
  errors << "hidden cases must not enter the repository" unless verification["hidden_cases_in_repository"] == false
end

execution = receipt["external_execution"]
errors << "external_execution must be a mapping" unless execution.is_a?(Hash)
if execution.is_a?(Hash)
  errors << "completed_runs must be >= 1" unless execution["completed_runs"].to_i >= 1
  errors << "provider must not be empty" if execution["provider"].to_s.strip.empty?
  errors << "model must not be empty" if execution["model"].to_s.strip.empty?
end

artifact = receipt["artifact"]
errors << "artifact must be a mapping" unless artifact.is_a?(Hash)
if artifact.is_a?(Hash)
  digest = artifact["sha256"].to_s
  errors << "artifact SHA-256 must be 64 hex characters" unless digest.match?(/\A[0-9a-f]{64}\z/)
  errors << "artifact byte size must be >= 0" unless artifact["bytes"].to_i >= 0

  if options[:check_files]
    artifact_path = artifact["path"].to_s
    if artifact_path.empty? || !File.file?(artifact_path)
      errors << "external benchmark artifact unavailable at #{artifact_path}"
    else
      errors << "artifact SHA-256 mismatch" unless Digest::SHA256.file(artifact_path).hexdigest == digest
      errors << "artifact byte size mismatch" unless File.size(artifact_path) == artifact["bytes"].to_i
    end
  end
end

forbidden = %w[cases gold_labels prompts hidden_cases]
forbidden.each { |key| errors << "receipt must not contain #{key}" if receipt.key?(key) }

if errors.any?
  errors.each { |error| warn "ERROR: #{error}" }
  abort "#{errors.length} hidden benchmark receipt verification error(s)"
end

puts "Hidden benchmark receipt verification"
puts "  receipt: #{path}"
puts "  source: external-only"
puts "  hidden payload: absent"
puts "  artifact integrity: #{options[:check_files] ? "checked" : "not checked"}"
puts "Hidden benchmark receipt verification passed."
