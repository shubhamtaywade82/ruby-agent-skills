#!/usr/bin/env ruby
# frozen_string_literal: true

require "optparse"
require "json"
require "fileutils"
require_relative "../lib/ruby_agent_skills/change_verifier"

USAGE = <<~TEXT
  usage: ruby bin/verify-change [PATH] [options]

  Verifies a change in a Ruby/Rails project with the project's own tools and
  writes an evidence report. PATH defaults to the current directory.

  Exit codes: 0 pass (or incomplete without --strict), 1 a check failed,
              2 usage error, 3 incomplete under --strict.
TEXT

options = { format: "json", skip: [], files: nil, strict: false, include_output: true,
            timeout: RubyAgentSkills::ChangeVerifier::DEFAULT_TIMEOUT }

parser = OptionParser.new do |opts|
  opts.banner = USAGE
  opts.on("--base REF", "Also include commits since REF (diff REF...HEAD)") do |v|
    options[:base] = v
  end
  opts.on("--files LIST", Array, "Comma-separated changed files; skips git detection") do |v|
    options[:files] = (options[:files] || []) + v
  end
  opts.on("--only LIST", Array, "Run only these checks") { |v| options[:only] = v }
  opts.on("--skip LIST", Array, "Skip these checks") { |v| options[:skip] += v }
  opts.on("--test-command CMD", "Test command (split on whitespace, run without a shell)") do |v|
    options[:test_command] = v
  end
  opts.on("--timeout SECONDS", Float, "Per-check timeout (default #{options[:timeout]})") do |v|
    options[:timeout] = v
  end
  opts.on("--format FORMAT", %w[json markdown], "json (default) or markdown") do |v|
    options[:format] = v
  end
  opts.on("--out FILE", "Also write the JSON evidence report to FILE") { |v| options[:out] = v }
  opts.on("--strict", "Exit 3 when an applicable check could not run") { options[:strict] = true }
  opts.on("--no-output", "Omit command output tails from the report") do
    options[:include_output] = false
  end
  opts.on("--list-checks", "Print check ids and exit") do
    puts RubyAgentSkills::ChangeVerifier::CHECK_IDS
    exit 0
  end
  opts.on("-h", "--help") do
    puts opts
    exit 0
  end
end

begin
  parser.parse!(ARGV)
  abort_usage = lambda { |message|
    warn "verify-change: #{message}"
    warn parser
    exit 2
  }
  abort_usage.call("expected at most one PATH") if ARGV.length > 1

  verifier = RubyAgentSkills::ChangeVerifier.new(
    root: ARGV.fetch(0, Dir.pwd), base: options[:base], files: options[:files],
    only: options[:only], skip: options[:skip], test_command: options[:test_command],
    timeout: options[:timeout],
    strict: options[:strict], include_output: options[:include_output]
  )
rescue OptionParser::ParseError, ArgumentError => e
  warn "verify-change: #{e.message}"
  warn parser
  exit 2
end

report = verifier.call

if options[:out]
  FileUtils.mkdir_p(File.dirname(File.expand_path(options[:out])))
  File.write(options[:out], "#{JSON.pretty_generate(report)}\n", encoding: "UTF-8")
end

if options[:format] == "markdown"
  puts RubyAgentSkills::ChangeVerifier::MarkdownReport.call(report)
else
  puts JSON.pretty_generate(report)
end

exit RubyAgentSkills::ChangeVerifier.exit_code_for(report)
