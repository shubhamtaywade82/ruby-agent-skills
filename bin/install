#!/usr/bin/env bash
set -euo pipefail

# Source resolution order:
#   1. RUBY_AGENT_SKILLS_REPO (explicit override)
#   2. The pack directory this script lives in (extracted release archive or
#      repository checkout: the directory containing skill-manifest.yml)
#   3. The public GitHub repository
SELF_ROOT=""
if [[ -f "${BASH_SOURCE[0]}" ]]; then
  SELF_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
fi
if [[ -n "${RUBY_AGENT_SKILLS_REPO:-}" ]]; then
  REPO="$RUBY_AGENT_SKILLS_REPO"
elif [[ -n "$SELF_ROOT" && -f "$SELF_ROOT/skill-manifest.yml" ]]; then
  REPO="$SELF_ROOT"
else
  REPO="https://github.com/shubhamtaywade82/ruby-agent-skills.git"
fi
REF="${RUBY_AGENT_SKILLS_REF:-main}"
SCOPE="user"
AGENT="agents"
PROJECT_DIR="$(pwd)"

usage() {
  cat <<'EOF'
Usage:
  bash bin/install [options]

Options:
  --scope user|project     Installation scope (default: user)
  --agent agents|codex|claude|copilot
                           Target agent layout (default: agents)
  --project DIR            Project root for --scope project
  --ref REF                Git branch, tag, or commit (default: main)
  --help                   Show this help

The source repository can be overridden with RUBY_AGENT_SKILLS_REPO.
A local plain directory (for example an extracted release archive
containing RELEASE.json) is installed directly without git.
When run from inside a pack directory (a repository checkout or an extracted
release archive), that directory is the default source.

Examples:
  bash bin/install --agent codex
  bash bin/install --scope project --agent agents
  bash bin/install --scope project --agent copilot --project /path/to/app
  bash bin/install --ref v1.0.0 --agent claude
EOF
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --scope)
      SCOPE="$2"; shift 2 ;;
    --agent)
      AGENT="$2"; shift 2 ;;
    --project)
      PROJECT_DIR="$2"; shift 2 ;;
    --ref)
      REF="$2"; shift 2 ;;
    --help|-h)
      usage; exit 0 ;;
    *)
      echo "Unknown argument: $1" >&2
      usage >&2
      exit 1 ;;
  esac
done

case "$SCOPE" in
  user|project) ;;
  *)
    echo "Invalid --scope: $SCOPE" >&2
    exit 1 ;;
esac

case "$AGENT" in
  agents|codex|claude|copilot) ;;
  *)
    echo "Invalid --agent: $AGENT" >&2
    exit 1 ;;
esac

if ! command -v git >/dev/null 2>&1; then
  echo "git is required." >&2
  exit 1
fi

sha256_file() {
  if command -v sha256sum >/dev/null 2>&1; then
    sha256sum "$1" | awk '{print $1}'
  elif command -v shasum >/dev/null 2>&1; then
    shasum -a 256 "$1" | awk '{print $1}'
  else
    echo "sha256sum or shasum is required." >&2
    exit 1
  fi
}

case "$AGENT" in
  agents|codex)
    if [[ "$SCOPE" == "user" ]]; then
      TARGET_ROOT="${HOME}/.agents/skills"
    else
      TARGET_ROOT="${PROJECT_DIR}/.agents/skills"
    fi
    ;;
  claude)
    if [[ "$SCOPE" == "user" ]]; then
      TARGET_ROOT="${HOME}/.claude/skills"
    else
      TARGET_ROOT="${PROJECT_DIR}/.claude/skills"
    fi
    ;;
  copilot)
    if [[ "$SCOPE" == "user" ]]; then
      TARGET_ROOT="${HOME}/.copilot/skills"
    else
      TARGET_ROOT="${PROJECT_DIR}/.github/skills"
    fi
    ;;
esac

TMP_DIR="$(mktemp -d)"
trap 'rm -rf "$TMP_DIR"' EXIT

# Source resolution: a git repository is cloned and checked out at REF.
# A plain local directory (an extracted release archive) is installed
# directly, recording the provenance embedded in its RELEASE.json.
REPO_DIR="$TMP_DIR/repo"
ARCHIVE_SOURCE=""
if [[ -d "$REPO" && -f "$REPO/skill-manifest.yml" ]] && ! git -C "$REPO" rev-parse --git-dir >/dev/null 2>&1; then
  ARCHIVE_SOURCE="$REPO"
fi

echo "Installing Ruby Agent Skills from:"
echo "  $REPO"
echo "  ref: $REF"
echo "  target: $TARGET_ROOT"
echo
echo "Review the repository/ref before installing untrusted skills."

if [[ -n "$ARCHIVE_SOURCE" ]]; then
  REPO_DIR="$ARCHIVE_SOURCE"
  REF="$(ruby -rjson -e '
    path = ARGV.fetch(0)
    data = JSON.parse(File.read(File.join(path, "RELEASE.json"))) rescue {}
    version = data["version"].to_s
    puts version.empty? ? "archive" : version
  ' "$ARCHIVE_SOURCE")"
  RESOLVED_SHA="$(ruby -rjson -e '
    path = ARGV.fetch(0)
    data = JSON.parse(File.read(File.join(path, "RELEASE.json"))) rescue {}
    sha = data["git_sha"].to_s
    puts sha.empty? ? "unrecorded" : sha
  ' "$ARCHIVE_SOURCE")"
else
  git clone --no-checkout --depth 1 "$REPO" "$REPO_DIR" >/dev/null 2>&1 || {
    echo "Unable to clone $REPO" >&2
    exit 1
  }
  if ! git -C "$REPO_DIR" fetch --depth 1 origin "$REF" >/dev/null 2>&1; then
    echo "Unable to fetch $REPO at ref $REF" >&2
    exit 1
  fi
  git -C "$REPO_DIR" checkout --detach FETCH_HEAD >/dev/null 2>&1 || {
    echo "Unable to checkout resolved ref $REF" >&2
    exit 1
  }

  RESOLVED_SHA="$(git -C "$REPO_DIR" rev-parse HEAD)"
fi

MANIFEST_SHA256="$(sha256_file "$REPO_DIR/skill-manifest.yml")"
ROUTING_SHA256="$(sha256_file "$REPO_DIR/router/ROUTING.md")"
SKILL_COUNT="$(find "$REPO_DIR/skills" -mindepth 2 -maxdepth 2 -name SKILL.md -type f | wc -l | tr -d ' ')"
PATTERN_COUNT="$(find "$REPO_DIR/patterns" -type f -name '*.md' ! -name README.md | wc -l | tr -d ' ')"

SKILL_FILE_HASHES="$(ruby -rdigest -rjson -e '
root = ARGV.fetch(0)
skill_dirs = Dir[File.join(root, "skills", "*", "SKILL.md")].map { |path| File.dirname(path) }
paths = skill_dirs.flat_map { |dir| Dir[File.join(dir, "**", "*")].select { |path| File.file?(path) } }.sort
puts JSON.generate(paths.map { |path|
  {"path" => path.delete_prefix(File.join(root, "skills") + "/"), "sha256" => Digest::SHA256.file(path).hexdigest}
})
' "$REPO_DIR")"

# Executables (and the library files they load) installed under
# .ruby-agent-skills/ and hash-verified by skill-pack-verify. Only files that
# exist in the source are installed, so older sources still install.
TOOL_PATHS="bin/stack-minimality bin/verify-change lib/ruby_agent_skills/change_verifier.rb lib/ruby_agent_skills/runtime_profile.rb"
TOOL_METADATA="$(ruby -rdigest -rjson -e '
root = ARGV.shift
puts JSON.generate(ARGV.select { |path| File.file?(File.join(root, path)) }.map { |path|
  {"path" => path, "sha256" => Digest::SHA256.file(File.join(root, path)).hexdigest}
})
' "$REPO_DIR" $TOOL_PATHS)"

PATTERN_FILE_HASHES="$(ruby -rdigest -rjson -e '
root = ARGV.fetch(0)
paths = Dir[File.join(root, "patterns", "**", "*.md")].reject { |path| path.end_with?("/README.md") }.sort
puts JSON.generate(paths.map { |path|
  {"path" => path.delete_prefix(root + "/"), "sha256" => Digest::SHA256.file(path).hexdigest}
})
' "$REPO_DIR")"

OLD_INSTALLATION="$TARGET_ROOT/.ruby-agent-skills/INSTALLATION.json"
if [[ -f "$OLD_INSTALLATION" ]]; then
  while IFS= read -r old_skill; do
    [[ "$old_skill" =~ ^[A-Za-z0-9][A-Za-z0-9_-]*$ ]] || continue
    [[ -d "$REPO_DIR/skills/$old_skill" ]] && continue
    rm -rf "$TARGET_ROOT/$old_skill"
    replacement="$(ruby -ryaml -e 'print YAML.safe_load(File.read(ARGV.fetch(0))).fetch("retired_skills", {}).fetch(ARGV.fetch(1), "")' "$REPO_DIR/skill-manifest.yml" "$old_skill")"
    if [[ -n "$replacement" ]]; then
      echo "Removed retired skill $old_skill (merged into $replacement)."
    else
      echo "Removed skill $old_skill (no longer in this skill pack)."
    fi
  done < <(ruby -rjson -e 'data=JSON.parse(File.read(ARGV.fetch(0))); Array(data.dig("inventory","skill_names")).each { |name| puts name }' "$OLD_INSTALLATION")
fi

STAGE="$TMP_DIR/stage"
mkdir -p "$STAGE/skills" "$STAGE/.ruby-agent-skills/patterns" "$STAGE/.ruby-agent-skills/docs" "$STAGE/.ruby-agent-skills/bin"

for skill_dir in "$REPO_DIR"/skills/*; do
  [[ -d "$skill_dir" ]] || continue
  [[ -f "$skill_dir/SKILL.md" ]] || continue
  cp -R "$skill_dir" "$STAGE/skills/$(basename "$skill_dir")"
done

cp -R "$REPO_DIR/patterns/." "$STAGE/.ruby-agent-skills/patterns/"
cp "$REPO_DIR/skill-manifest.yml" "$STAGE/.ruby-agent-skills/skill-manifest.yml"
cp "$REPO_DIR/router/ROUTING.md" "$STAGE/.ruby-agent-skills/ROUTING.md"
cp "$REPO_DIR/AGENTS.md" "$STAGE/.ruby-agent-skills/AGENTS.md"
cp "$REPO_DIR/docs/SKILL_CONTRACT.md" "$STAGE/.ruby-agent-skills/docs/SKILL_CONTRACT.md"
cp "$REPO_DIR/bin/skill-pack-verify" "$STAGE/.ruby-agent-skills/skill-pack-verify"
for tool in $TOOL_PATHS; do
  [[ -f "$REPO_DIR/$tool" ]] || continue
  mkdir -p "$(dirname "$STAGE/.ruby-agent-skills/$tool")"
  cp "$REPO_DIR/$tool" "$STAGE/.ruby-agent-skills/$tool"
done
if [[ -f "$REPO_DIR/docs/VERIFY_CHANGE.md" ]]; then
  cp "$REPO_DIR/docs/VERIFY_CHANGE.md" "$STAGE/.ruby-agent-skills/docs/VERIFY_CHANGE.md"
fi

cat > "$STAGE/.ruby-agent-skills/INSTALLATION.json" <<EOF
{
  "protocol_version": 1,
  "source": {
    "repository": "$REPO",
    "requested_ref": "$REF",
    "resolved_git_sha": "$RESOLVED_SHA"
  },
  "integrity": {
    "skill_manifest_sha256": "$MANIFEST_SHA256",
    "routing_contract_sha256": "$ROUTING_SHA256",
    "skill_files": $SKILL_FILE_HASHES,
    "pattern_files": $PATTERN_FILE_HASHES,
    "tools": $TOOL_METADATA
  },
  "inventory": {
    "skills": $SKILL_COUNT,
    "patterns": $PATTERN_COUNT,
    "skill_names": [$(find "$REPO_DIR/skills" -mindepth 1 -maxdepth 1 -type d -exec basename {} \; | sort | awk '{printf "%s%s", sep, "\""$0"\""; sep=","}' )]
  },
  "target": {
    "agent": "$AGENT",
    "scope": "$SCOPE"
  }
}
EOF

mkdir -p "$TARGET_ROOT"
for skill_dir in "$STAGE"/skills/*; do
  [[ -d "$skill_dir" ]] || continue
  skill_name="$(basename "$skill_dir")"
  rm -rf "$TARGET_ROOT/$skill_name"
  cp -R "$skill_dir" "$TARGET_ROOT/$skill_name"
done

rm -rf "$TARGET_ROOT/.ruby-agent-skills.tmp"
cp -R "$STAGE/.ruby-agent-skills" "$TARGET_ROOT/.ruby-agent-skills.tmp"
rm -rf "$TARGET_ROOT/.ruby-agent-skills"
mv "$TARGET_ROOT/.ruby-agent-skills.tmp" "$TARGET_ROOT/.ruby-agent-skills"

echo
echo "Installed $SKILL_COUNT skills and $PATTERN_COUNT patterns."
echo "Resolved commit: $RESOLVED_SHA"
echo "Manifest SHA-256: $MANIFEST_SHA256"
echo "Routing SHA-256:  $ROUTING_SHA256"
echo "Installation record: $TARGET_ROOT/.ruby-agent-skills/INSTALLATION.json"
ruby "$TARGET_ROOT/.ruby-agent-skills/skill-pack-verify" --root "$TARGET_ROOT"
