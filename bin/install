#!/usr/bin/env bash
set -euo pipefail

REPO="${RUBY_AGENT_SKILLS_REPO:-https://github.com/shubhamtaywade82/ruby-agent-skills.git}"
REF="${RUBY_AGENT_SKILLS_REF:-main}"
SCOPE="user"
AGENT="agents"
PROJECT_DIR="$(pwd)"

usage() {
  cat <<'EOF'
Usage:
  bash bin/install [options]

Options:
  --scope user|project     Installation scope (default: user)
  --agent agents|codex|claude|copilot
                           Target agent layout (default: agents)
  --project DIR            Project root for --scope project
  --ref REF                Git branch, tag, or commit (default: main)
  --help                   Show this help

Examples:
  bash bin/install --agent codex
  bash bin/install --scope project --agent agents
  bash bin/install --scope project --agent copilot --project /path/to/app
  bash bin/install --ref v1.0.0 --agent claude
EOF
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --scope)
      SCOPE="$2"; shift 2 ;;
    --agent)
      AGENT="$2"; shift 2 ;;
    --project)
      PROJECT_DIR="$2"; shift 2 ;;
    --ref)
      REF="$2"; shift 2 ;;
    --help|-h)
      usage; exit 0 ;;
    *)
      echo "Unknown argument: $1" >&2
      usage >&2
      exit 1 ;;
  esac
done

case "$SCOPE" in
  user|project) ;;
  *)
    echo "Invalid --scope: $SCOPE" >&2
    exit 1 ;;
esac

case "$AGENT" in
  agents|codex|claude|copilot) ;;
  *)
    echo "Invalid --agent: $AGENT" >&2
    exit 1 ;;
esac

if ! command -v git >/dev/null 2>&1; then
  echo "git is required." >&2
  exit 1
fi

sha256_file() {
  if command -v sha256sum >/dev/null 2>&1; then
    sha256sum "$1" | awk '{print $1}'
  elif command -v shasum >/dev/null 2>&1; then
    shasum -a 256 "$1" | awk '{print $1}'
  else
    echo "sha256sum or shasum is required." >&2
    exit 1
  fi
}

case "$AGENT" in
  agents|codex)
    if [[ "$SCOPE" == "user" ]]; then
      TARGET_ROOT="${HOME}/.agents/skills"
    else
      TARGET_ROOT="${PROJECT_DIR}/.agents/skills"
    fi
    ;;
  claude)
    if [[ "$SCOPE" == "user" ]]; then
      TARGET_ROOT="${HOME}/.claude/skills"
    else
      TARGET_ROOT="${PROJECT_DIR}/.claude/skills"
    fi
    ;;
  copilot)
    if [[ "$SCOPE" == "user" ]]; then
      TARGET_ROOT="${HOME}/.copilot/skills"
    else
      TARGET_ROOT="${PROJECT_DIR}/.github/skills"
    fi
    ;;
esac

TMP_DIR="$(mktemp -d)"
trap 'rm -rf "$TMP_DIR"' EXIT

echo "Installing Ruby Agent Skills from:"
echo "  $REPO"
echo "  ref: $REF"
echo "  target: $TARGET_ROOT"
echo
echo "Review the repository/ref before installing untrusted skills."

git clone --depth 1 --branch "$REF" "$REPO" "$TMP_DIR/repo" >/dev/null 2>&1 || {
  echo "Unable to clone $REPO at ref $REF" >&2
  exit 1
}

RESOLVED_SHA="$(git -C "$TMP_DIR/repo" rev-parse HEAD)"
MANIFEST_SHA256="$(sha256_file "$TMP_DIR/repo/skill-manifest.yml")"
ROUTING_SHA256="$(sha256_file "$TMP_DIR/repo/router/ROUTING.md")"
SKILL_COUNT="$(find "$TMP_DIR/repo/skills" -mindepth 2 -maxdepth 2 -name SKILL.md -type f | wc -l | tr -d ' ')"
PATTERN_COUNT="$(find "$TMP_DIR/repo/patterns" -type f -name '*.md' ! -name README.md | wc -l | tr -d ' ')"

OLD_INSTALLATION="$TARGET_ROOT/.ruby-agent-skills/INSTALLATION.json"
if [[ -f "$OLD_INSTALLATION" ]]; then
  while IFS= read -r old_skill; do
    [[ -z "$old_skill" ]] && continue
    [[ -d "$TMP_DIR/repo/skills/$old_skill" ]] && continue
    rm -rf "$TARGET_ROOT/$old_skill"
  done < <(ruby -rjson -e 'data=JSON.parse(File.read(ARGV.fetch(0))); Array(data.dig("inventory","skill_names")).each { |name| puts name }' "$OLD_INSTALLATION")
fi

STAGE="$TMP_DIR/stage"
mkdir -p "$STAGE/skills" "$STAGE/.ruby-agent-skills/patterns" "$STAGE/.ruby-agent-skills/docs"

for skill_dir in "$TMP_DIR/repo"/skills/*; do
  [[ -d "$skill_dir" ]] || continue
  [[ -f "$skill_dir/SKILL.md" ]] || continue
  cp -R "$skill_dir" "$STAGE/skills/$(basename "$skill_dir")"
done

cp -R "$TMP_DIR/repo/patterns/." "$STAGE/.ruby-agent-skills/patterns/"
cp "$TMP_DIR/repo/skill-manifest.yml" "$STAGE/.ruby-agent-skills/skill-manifest.yml"
cp "$TMP_DIR/repo/router/ROUTING.md" "$STAGE/.ruby-agent-skills/ROUTING.md"
cp "$TMP_DIR/repo/AGENTS.md" "$STAGE/.ruby-agent-skills/AGENTS.md"
cp "$TMP_DIR/repo/docs/SKILL_CONTRACT.md" "$STAGE/.ruby-agent-skills/docs/SKILL_CONTRACT.md"

cat > "$STAGE/.ruby-agent-skills/INSTALLATION.json" <<EOF
{
  "protocol_version": 1,
  "source": {
    "repository": "$REPO",
    "requested_ref": "$REF",
    "resolved_git_sha": "$RESOLVED_SHA"
  },
  "integrity": {
    "skill_manifest_sha256": "$MANIFEST_SHA256",
    "routing_contract_sha256": "$ROUTING_SHA256"
  },
  "inventory": {
    "skills": $SKILL_COUNT,
    "patterns": $PATTERN_COUNT,
    "skill_names": [$(find "$TMP_DIR/repo/skills" -mindepth 1 -maxdepth 1 -type d -exec basename {} ; | sort | awk '{printf "%s%s", sep, "\""$0"\""; sep=","}' )]
  },
  "target": {
    "agent": "$AGENT",
    "scope": "$SCOPE"
  }
}
EOF

mkdir -p "$TARGET_ROOT"
for skill_dir in "$STAGE"/skills/*; do
  [[ -d "$skill_dir" ]] || continue
  skill_name="$(basename "$skill_dir")"
  rm -rf "$TARGET_ROOT/$skill_name"
  cp -R "$skill_dir" "$TARGET_ROOT/$skill_name"
done

rm -rf "$TARGET_ROOT/.ruby-agent-skills.tmp"
cp -R "$STAGE/.ruby-agent-skills" "$TARGET_ROOT/.ruby-agent-skills.tmp"
rm -rf "$TARGET_ROOT/.ruby-agent-skills"
mv "$TARGET_ROOT/.ruby-agent-skills.tmp" "$TARGET_ROOT/.ruby-agent-skills"

echo
echo "Installed $SKILL_COUNT skills and $PATTERN_COUNT patterns."
echo "Resolved commit: $RESOLVED_SHA"
echo "Manifest SHA-256: $MANIFEST_SHA256"
echo "Routing SHA-256:  $ROUTING_SHA256"
echo "Installation record: $TARGET_ROOT/.ruby-agent-skills/INSTALLATION.json"
