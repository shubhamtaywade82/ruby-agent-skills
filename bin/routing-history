#!/usr/bin/env ruby
# frozen_string_literal: true

require "digest"
require "json"
require "optparse"
require "open3"
require "tempfile"

options = { output: nil, verify: false }
VERIFYER = File.join(File.expand_path("..", __dir__), "bin", "routing-history-verify")
OptionParser.new do |opts|
  opts.banner = "usage: ruby bin/routing-history ARCHIVE_ROOT [options]"
  opts.on("--output PATH", "Write history JSON") { |v| options[:output] = File.expand_path(v) }
  opts.on("--verify", "Replay archive verification before reporting history") { options[:verify] = true }
end.parse!

root = File.expand_path(ARGV.fetch(0) { abort "archive root is required" })
abort "archive root not found: #{root}" unless Dir.exist?(root)

entries = Dir[File.join(root, "**", "ARCHIVE_MANIFEST.json")].sort.map do |path|
  manifest = JSON.parse(File.read(path, encoding: "UTF-8"))
  next unless manifest["evidence_type"] == "skill-routing-campaign-v1"

  {
    "archive_id" => manifest["archive_id"],
    "captured_at" => manifest["captured_at"],
    "campaign" => manifest["campaign_metrics"] ? manifest["archive_id"].split("/").first : nil,
    "evidence_type" => manifest["evidence_type"],
    "repository" => manifest["repository"],
    "agent" => manifest["agent"],
    "campaign_metrics" => manifest["campaign_metrics"],
    "analysis" => manifest["analysis"],
    "artifact_count" => manifest.fetch("artifacts").length,
    "archive_path" => File.dirname(path),
    "archive_path_relative" => File.dirname(path).delete_prefix(root + "/"),
    "archive_manifest_sha256" => Digest::SHA256.file(path).hexdigest
  }
end.compact

entries.sort_by! { |entry| [entry["campaign"].to_s, entry["captured_at"].to_s, entry["archive_id"].to_s] }

archive_set = entries.map do |entry|
  {
    "archive_id" => entry["archive_id"],
    "archive_path_relative" => entry["archive_path_relative"],
    "archive_manifest_sha256" => entry["archive_manifest_sha256"]
  }
end.sort_by { |entry| [entry["archive_id"].to_s, entry["archive_path_relative"].to_s] }

history = {
  "protocol_version" => 1,
  "history" => "skill-routing-history-v1",
  "archive_root" => root,
  "campaign_count" => entries.length,
  "archive_set_sha256" => Digest::SHA256.hexdigest(JSON.generate(archive_set)),
  "entries" => entries
}

json = JSON.pretty_generate(history) + "\n"
if options[:verify]
  Tempfile.create(["routing-history-", ".json"]) do |temp|
    File.write(temp.path, json, encoding: "UTF-8")
    stdout, stderr, status = Open3.capture3(
      RbConfig.ruby, VERIFYER, temp.path, "--check-files", chdir: File.expand_path("..", __dir__)
    )
    warn stderr unless stderr.empty?
    abort "routing history verification failed" unless status.success?
    warn stdout unless stdout.empty?
  end
end

File.write(options[:output], json, encoding: "UTF-8") if options[:output]
puts json
