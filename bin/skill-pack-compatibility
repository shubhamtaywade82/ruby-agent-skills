#!/usr/bin/env ruby
# frozen_string_literal: true

require "json"
require "optparse"
require_relative "../lib/ruby_agent_skills/runtime_profile"
require_relative "../lib/ruby_agent_skills/skill_pack"

root = File.expand_path("..", __dir__)
options = { skills: [], patterns: [], strict: false, json: false }

OptionParser.new do |opts|
  opts.banner = "usage: ruby bin/skill-pack-compatibility TARGET_ROOT [options]"
  opts.on("--skill ID", "Skill ID to evaluate (repeatable)") { |value| options[:skills] << value }
  opts.on("--pattern ID", "Pattern ID/path to evaluate (repeatable)") { |value| options[:patterns] << value }
  opts.on("--strict", "Treat unknown/conflicted runtime evidence as a compatibility failure") { options[:strict] = true }
  opts.on("--json", "Emit JSON") { options[:json] = true }
end.parse!

target = ARGV.shift
abort "usage: ruby bin/skill-pack-compatibility TARGET_ROOT [options]" unless target

target = File.expand_path(target)
abort "target repository does not exist: #{target}" unless Dir.exist?(target)
abort "select at least one --skill or --pattern" if options[:skills].empty? && options[:patterns].empty?

runtime_profile = RubyAgentSkills::RuntimeProfile.call(target)
evaluation = {
  "skills" => options[:skills],
  "patterns" => options[:patterns]
}
report = RubyAgentSkills::SkillPack.new(root: root).compatibility_report(
  evaluation: evaluation,
  runtime_profile: runtime_profile
)
report["runtime_profile"] = runtime_profile
report["strict"] = options[:strict]

if options[:json]
  puts JSON.pretty_generate(report)
else
  puts "Skill-pack compatibility"
  puts "  status: #{report.fetch("status")}"
  puts "  target: #{target}"
  report.fetch("requirements").each do |name, result|
    puts "  #{name}: #{result.fetch("status")}"
  end
end

exit 1 if report.fetch("status") == "unsupported" || report.fetch("status") == "conflict"
exit 1 if options[:strict] && report.fetch("status") == "unknown"
